<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.cpghub</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>-c</string>
    <string>cd /Users/apple/crossEC &amp;&amp; source .venv/bin/activate &amp;&amp; exec caffeinate -i uvicorn main:app --host 0.0.0.0 --port 8000</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>StandardOutPath</key>
  <string>/Users/apple/crossEC/logs/launchd.out.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/apple/crossEC/logs/launchd.err.log</string>
  <key>WorkingDirectory</key>
  <string>/Users/apple/crossEC</string>
</dict>
</plist>
