# ===========================================
# CPG-Hub 环境变量配置模板（仅读取本项目 .env，独立运行）
# 复制此文件为 .env 并填入实际值。未配置时首屏仍可展示政策库/爬虫数据，缺失项会提示配置。
# 真实环境需配置：OMKAR_CLOUD_API_KEY（海外热销）、LLM 任选其一（选品分析）、PERPLEXITY/OPENROUTER（政策自动搜索）。
# ===========================================

# -------------------------------------------
# A. 核心能力层：OpenClaw (ClawHub)
# 申请地址: https://www.clawhub.com/
# 用途: 调用百度优选 Skill（商品检索、比价、口碑分析）
# -------------------------------------------
OPENCLAW_API_KEY=your_openclaw_api_key_here

# -------------------------------------------
# B. 大模型层：二选一或同时配置
# 政策自动搜索需 OPENROUTER_API_KEY（来自 ~/.openclaw）
# -------------------------------------------

# 智谱清言 Zhipu AI (OpenAI 兼容)
# 申请地址: https://open.bigmodel.cn/
ZHIPU_API_KEY=your_zhipu_api_key_here
ZHIPU_MODEL_ID=glm-4-flash
ZHIPU_API_BASE=https://open.bigmodel.cn/api/paas/v4

# 百度千帆大模型
# 申请地址: https://console.bce.baidu.com/ → 千帆大模型平台
BAIDU_API_KEY=your_baidu_api_key_here
BAIDU_MODEL_ID=APIKey-xxxxxxxx
BAIDU_API_BASE=https://aip.baidubce.com

# OpenAI (备选)
# 申请地址: https://platform.openai.com/
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_API_BASE=https://api.openai.com/v1

# 默认使用的 LLM 提供商: baidu | zhipu | openai
LLM_PROVIDER=zhipu

# -------------------------------------------
# C. 海外电商数据源 (GitHub 成熟工具)
# -------------------------------------------

# omkarcloud/amazon-scraper API
# 申请地址: https://www.omkar.cloud/auth/sign-up → API Key
# 5000 次/月免费
OMKAR_CLOUD_API_KEY=your_omkar_cloud_api_key_here

# 可选：ScrapingAnt - 处理验证码和 IP 封禁
# 申请地址: https://www.scrapingant.com/
SCRAPINGANT_API_KEY=

# 可选：Apify - 云端爬虫 Actor 接口
# 申请地址: https://apify.com/
APIFY_API_TOKEN=

# TikTok: pyktok 本地采集，无需 API；或使用官方 TikTok Shop API
# TIKTOK_APP_KEY=
# TIKTOK_APP_SECRET=

# -------------------------------------------
# D. 主数据库：MySQL（政策、媒体热点、政策分析）
# 首次部署：创建库后应用启动会自动建表；若库不存在会自动 CREATE DATABASE
# -------------------------------------------
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_password
MYSQL_DATABASE=cpg_hub

# -------------------------------------------
# E. MongoDB（可选，当前未使用）
# -------------------------------------------
MONGODB_URI=

# -------------------------------------------
# 应用配置
# -------------------------------------------
APP_ENV=development
LOG_LEVEL=INFO
API_PREFIX=/api/v1
# 服务端口，默认 8000（macOS 上 5000 常被系统 AirPlay 占用，建议用 8000）
# PORT=8000

# 全量同步间隔（分钟），0 = 禁用
SYNC_INTERVAL_MINUTES=0
# OpenClaw/百度优选持续积累间隔（分钟），>0 时定期追加政策与热销，首屏内容不断增多；默认 15
SYNC_ACCUMULATE_INTERVAL_MINUTES=15

# 飞书通知（新政策时通知指定用户，如 余为军）
# 应用：飞书开放平台创建应用，获取 App ID / App Secret
# 接收人 open_id：在飞书开放平台「通讯录」或 API「获取用户 ID」中查看
# FEISHU_APP_ID=
# FEISHU_APP_SECRET=
# FEISHU_NOTIFY_OPEN_ID=ou_xxxx   # 余为军 的 open_id

# 政策自动搜索（可选，Perplexity/OpenRouter）
# PERPLEXITY_API_KEY=
# OPENROUTER_API_KEY=

# -------------------------------------------
# ahotnews 集成（抖音/快手/微博等关键词爬取）
# 先执行 scripts/setup_ahotnews.sh 克隆仓库，再配置 ahotnews 自身 .env
# -------------------------------------------
AHOTNEWS_ENABLED=false
AHOTNEWS_PATH=vendor/ahotnews
AHOTNEWS_DB_HOST=localhost
AHOTNEWS_DB_PORT=3306
AHOTNEWS_DB_USER=
AHOTNEWS_DB_PASSWORD=
AHOTNEWS_DB_NAME=mindspider
AHOTNEWS_DB_DIALECT=mysql

# 我的媒体链接存储文件（抖音/快手/财新/微博等）
MEDIA_LINKS_FILE=data/media_links.json
